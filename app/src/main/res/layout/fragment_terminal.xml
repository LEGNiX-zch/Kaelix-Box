<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_terminal"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/terminal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/terminal_output"
            style="@style/TerminalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF2A2F33" />

    <LinearLayout
        android:id="@+id/start_container_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_start_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_start_container" />
    </LinearLayout>

    <EditText
        android:id="@+id/terminal_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_terminal_input"
        android:hint="@string/terminal_hint"
        android:inputType="text|textNoSuggestions|textMultiLine"
        android:imeOptions="actionSend"
        android:maxLines="3"
        android:padding="10dp"
        android:textColor="@color/text_terminal"
        android:textColorHint="#FF8A9197"
        android:textSize="13sp"
        android:fontFamily="monospace" />
</LinearLayout>
