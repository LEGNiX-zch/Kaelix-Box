<?xml version="1.0" encoding="utf-8"?>
<!-- Circular avatar background: just a blue ring (stroke) with transparent
     fill so the photo itself fills the circle. The ImageView uses
     clipToOutline + centerCrop to clip the photo into the circle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="3dp" android:color="#1565C0" />
</shape>
