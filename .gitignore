# Do not commit local container images / rootfs
# 镜像托管在 GitHub Releases，禁止提交进源码仓库
*.tar.xz
*.tar.zst
*.sha256
rootfs/

# Build artifact: proot is downloaded at build time from the top-level
# /proot file via the downloadProot Gradle task, staged as a fake .so
# under jniLibs so AGP packages it into lib/arm64-v8a/ (exec-permitted at
# runtime, bypassing filesDir noexec on Android 13+). Do not commit this copy.
app/src/main/jniLibs/arm64-v8a/libproot.so

